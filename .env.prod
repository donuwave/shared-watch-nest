# =============== DATABASE ===============
POSTGRES_USER=shared_watch
POSTGRES_PASSWORD=prod_strong_password_123
POSTGRES_DB=shared_watch_prod

DB_HOST=postgres
DB_PORT=5432

# =============== APP ===============
NODE_ENV=production
PORT=9000

# =============== JWT ===============
JWT_ACCESS_SECRET=prod_super_secret_change_in_production
JWT_ACCESS_EXPIRATION=7200s
JWT_REFRESH_SECRET=prod_refresh_super_secret_change_in_production
JWT_REFRESH_EXPIRATION=30d

# =============== COOKIE ===============
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# =============== MAIL ===============
APP_FRONTEND_URL=https://shared-watch.example.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Shared Watch <no-reply@shared-watch.example.com>"
MAIL_SECURE=false

# =============== Sessions ===============
MAX_SESSIONS_PER_USER=5
SESSION_EXPIRATION=604800
