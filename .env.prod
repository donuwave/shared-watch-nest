# =============== DATABASE ===============
POSTGRES_USER=shared_watch
POSTGRES_PASSWORD=prod_strong_password_123
POSTGRES_DB=shared_watch_prod

DB_HOST=postgres
DB_PORT=5432

# =============== APP ===============
NODE_ENV=production
PORT=9000

# =============== JWT ===============
JWT_ACCESS_SECRET=prod_super_secret_change_in_production
JWT_ACCESS_EXPIRATION=7200s
JWT_REFRESH_SECRET=prod_refresh_super_secret_change_in_production
JWT_REFRESH_EXPIRATION=30d

# =============== COOKIE ===============
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# =============== GITHUB OAUTH ===============
GITHUB_CLIENT_ID=change_me
GITHUB_CLIENT_SECRET=change_me
GITHUB_CALLBACK_URL=https://shared-watch.example.com/auth/github/callback

# =============== GOOGLE OAUTH ===============
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
GOOGLE_CALLBACK_URL=https://shared-watch.example.com/auth/google/callback

# =============== YANDEX OAUTH ===============
YANDEX_CLIENT_ID=change_me
YANDEX_CLIENT_SECRET=change_me
YANDEX_CALLBACK_URL=https://shared-watch.example.com/auth/yandex/callback

# =============== VK OAUTH ===============
VK_CLIENT_ID=change_me
VK_CLIENT_SECRET=change_me
VK_CALLBACK_URL=https://shared-watch.example.com/auth/vk/callback

# =============== MAIL ===============
APP_FRONTEND_URL=https://shared-watch.example.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Shared Watch <no-reply@shared-watch.example.com>"
MAIL_SECURE=false

# =============== Sessions ===============
MAX_SESSIONS_PER_USER=5
SESSION_EXPIRATION=604800

# =============== Rooms ===============
ROOM_CLEANUP_INTERVAL_MS=60000
ROOM_PRESENCE_GRACE_PERIOD_MS=180000
